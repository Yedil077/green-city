# Скопируйте этот файл в .dev.vars (без .example) для локальной разработки (`npm run dev`).
# .dev.vars НЕ коммитится в git (см. .gitignore) — это только ваша локальная копия.
# В продакшене этот секрет задаётся отдельно: wrangler secret put GOOGLE_SERVICE_ACCOUNT_JSON

GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@...iam.gserviceaccount.com","client_id":"...","token_uri":"https://oauth2.googleapis.com/token"}
